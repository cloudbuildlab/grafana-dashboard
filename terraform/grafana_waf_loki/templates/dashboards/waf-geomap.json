{
  "id": null,
  "title": "WAF GeoMap",
  "uid": "waf-geomap",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "2m",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "bucket",
        "label": "Bucket",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "definition": "label_values({source=\"waf\"}, bucket)",
        "query": "label_values({source=\"waf\"}, bucket)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "waf_acl",
        "label": "Web ACL",
        "description": "Matches JSON field waf_acl after | json. All uses .* (see waf-overview).",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "definition": "label_values({source=\"waf\", bucket=~\"${bucket:regex}\"}, waf_acl)",
        "query": "label_values({source=\"waf\", bucket=~\"${bucket:regex}\"}, waf_acl)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "top_ip_n",
        "label": "Top IPs",
        "type": "custom",
        "query": "10,20,50",
        "options": [
          { "selected": true, "text": "10", "value": "10" },
          { "selected": false, "text": "20", "value": "20" },
          { "selected": false, "text": "50", "value": "50" }
        ],
        "current": { "selected": true, "text": "10", "value": "10" },
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "geomap",
      "title": "Traffic by client IP (GeoIP)",
      "description": "geo_lat/geo_lon from clientIp via geoip-lite (approx). Fields clientIp + country on each line for tooltips.",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "hideFrom": { "legend": false, "tooltip": false, "viz": false }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "expr": "topk(500, sum by (clientIp, country, geo_lat, geo_lon) (count_over_time({source=\"waf\", bucket=~\"${bucket:regex}\"} | json | waf_acl=~\"${waf_acl:regex}\" | clientIp != \"\" | country != \"\" | geo_lat != \"\" | geo_lon != \"\" [$__range])))",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": { "Value": "hits" }
          }
        }
      ],
      "options": {
        "basemap": { "config": {}, "name": "Layer 0", "type": "default" },
        "controls": {
          "mouseWheelZoom": true,
          "showAttribution": true,
          "showDebug": false,
          "showMeasure": false,
          "showScale": true,
          "showZoom": true
        },
        "layers": [
          {
            "type": "markers",
            "name": "GeoIP",
            "config": {
              "showLegend": true,
              "style": {
                "color": { "fixed": "semi-dark-blue" },
                "opacity": 0.88,
                "shape": "circle",
                "size": { "field": "hits", "fixed": 8, "max": 22, "min": 5 }
              }
            },
            "location": {
              "mode": "coords",
              "latitude": "geo_lat",
              "longitude": "geo_lon"
            },
            "tooltip": true,
            "opacity": 1
          }
        ],
        "tooltip": { "mode": "details" },
        "view": {
          "allLayers": true,
          "id": "zero",
          "lat": 20,
          "lon": 0,
          "zoom": 1.2
        }
      }
    },
    {
      "id": 2,
      "type": "geomap",
      "title": "Volume by country (centroid)",
      "description": "Grouped by country using server-side Loki aggregation. Marker size reflects hit volume.",
      "gridPos": { "h": 11, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "hideFrom": { "legend": false, "tooltip": false, "viz": false }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "expr": "topk(150, sum by (country, country_lat, country_lon) (count_over_time({source=\"waf\", bucket=~\"${bucket:regex}\"} | json | waf_acl=~\"${waf_acl:regex}\" | country != \"\" | country_lat != \"\" | country_lon != \"\" [$__range])))",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value": "hits"
            }
          }
        }
      ],
      "options": {
        "basemap": { "config": {}, "name": "Layer 0", "type": "default" },
        "controls": {
          "mouseWheelZoom": true,
          "showAttribution": true,
          "showDebug": false,
          "showMeasure": false,
          "showScale": true,
          "showZoom": true
        },
        "layers": [
          {
            "type": "markers",
            "name": "By country",
            "config": {
              "showLegend": true,
              "style": {
                "color": { "fixed": "dark-green" },
                "opacity": 0.9,
                "shape": "circle",
                "size": {
                  "field": "hits",
                  "fixed": 8,
                  "max": 40,
                  "min": 6
                }
              }
            },
            "location": {
              "mode": "coords",
              "latitude": "country_lat",
              "longitude": "country_lon"
            },
            "tooltip": true,
            "opacity": 1
          }
        ],
        "tooltip": { "mode": "details" },
        "view": {
          "allLayers": true,
          "id": "zero",
          "lat": 20,
          "lon": 0,
          "zoom": 1.2
        }
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Top IP",
      "gridPos": { "h": 11, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "expr": "topk(${top_ip_n}, sum by (clientIp, country) (count_over_time({source=\"waf\", bucket=~\"${bucket:regex}\"} | json | waf_acl=~\"${waf_acl:regex}\" | clientIp != \"\" | country != \"\" [$__range])))",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": ["sum"],
          "show": false
        },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "hits" }]
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": { "mode": "columns" }
        },
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "clientIp": { "operation": "groupby" },
              "country": { "operation": "groupby" },
              "Value": {
                "operation": "aggregate",
                "aggregations": ["max"]
              }
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "indexByName": {
              "clientIp": 0,
              "country": 1,
              "Value (max)": 2
            },
            "renameByName": {
              "clientIp": "Client IP",
              "country": "Country",
              "Value (max)": "hits",
              "Value": "hits",
              "Value #A": "hits"
            }
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [{ "field": "hits", "desc": true }]
          }
        },
        {
          "id": "limit",
          "options": { "limitField": "${top_ip_n}" }
        }
      ]
    }
  ]
}
