{
  "id": null,
  "title": "WAF Top URLs",
  "uid": "waf-top-urls",
  "schemaVersion": 39,
  "version": 8,
  "refresh": "5m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "bucket",
        "label": "Bucket",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "definition": "label_values({source=\"waf\"}, bucket)",
        "query": "label_values({source=\"waf\"}, bucket)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "waf_acl",
        "label": "Web ACL",
        "description": "Matches JSON field waf_acl after | json.",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "definition": "label_values({source=\"waf\", bucket=~\"${bucket:regex}\"}, waf_acl)",
        "query": "label_values({source=\"waf\", bucket=~\"${bucket:regex}\"}, waf_acl)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "top_n",
        "label": "Top URLs",
        "type": "custom",
        "query": "10,20,50",
        "options": [
          {
            "selected": true,
            "text": "10",
            "value": "10"
          },
          {
            "selected": false,
            "text": "20",
            "value": "20"
          },
          {
            "selected": false,
            "text": "50",
            "value": "50"
          }
        ],
        "current": {
          "selected": true,
          "text": "10",
          "value": "10"
        },
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Top requested full URLs (request_url)",
      "description": "Uses recording rule metric `waf_uri_requests_total` (derived from JSON request_url) for lower query cost than raw log scans.",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "topk(${top_n}, sum by (request_url) (sum_over_time(waf_uri_requests_total{bucket=~\"${bucket:regex}\", waf_acl=~\"${waf_acl:regex}\", request_url!=\"\"}[$__range])))",
          "queryType": "instant",
          "instant": true,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Requests" },
            "properties": [
              { "id": "custom.align", "value": "right" },
              { "id": "custom.width", "value": 140 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Full URL" },
            "properties": [{ "id": "custom.align", "value": "left" }]
          }
        ]
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": { "mode": "columns" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "indexByName": {
              "request_url": 0,
              "Value #A": 1,
              "Value": 1
            },
            "renameByName": {
              "request_url": "Full URL",
              "Value #A": "Requests",
              "Value": "Requests"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [{ "field": "Requests", "desc": true }]
          }
        }
      ],
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": ["sum"],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Requests",
            "desc": true
          }
        ]
      }
    }
  ]
}
